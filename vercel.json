{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.veridian-ware.com"
        }
      ],
      "destination": "https://veridian-ware.com/:path*",
      "permanent": true
    },
    {
      "source": "/blog/factura-electronica-afip-wsfev1/",
      "destination": "/blog/factura-electronica-arca-wsfev1/",
      "permanent": true
    },
    {
      "source": "/blog/factura-electronica-afip-wsfev1",
      "destination": "/blog/factura-electronica-arca-wsfev1/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
